            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/coupons/99999",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "coupons", "99999"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Happy-Path Flow (run in order)",
      "item": [
        {
          "name": "Step 1 - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",       "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+96512345678\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Step 2 - Create Coupon (15% multi-use limit 50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('coupon_id', json.id);",
                  "    pm.collectionVariables.set('coupon_code', json.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HAPPY15\",\n  \"discount_type\": \"percentage\",\n  \"discount_value\": 15,\n  \"usage_type\": \"multi\",\n  \"usage_limit\": 50,\n  \"is_active\": true,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/coupons",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "coupons"]
            }
          }
        },
        {
          "name": "Step 3 - Check Code (subtotal 100, expect discount 15)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HAPPY15\",\n  \"subtotal\": 100.000\n}"
            },
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/coupons/check-code",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "coupons", "check-code"]
            }
          }
        },
        {
          "name": "Step 4 - Place Order with Coupon + Discount",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('order_id', json.id);",
                  "    console.log('subtotal_price:', json.subtotal_price);",
                  "    console.log('discount_amount:', json.discount_amount);",
                  "    console.log('total_price:', json.total_price);",
                  "    console.log('coupon_data:', JSON.stringify(json.coupon_data));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coupon_code\": \"HAPPY15\",\n  \"order_lines\": [\n    { \"item_id\": 1, \"count\": 2 }\n  ],\n  \"discounts\": [\n    { \"amount\": 5.000, \"type\": \"fixed\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/orders",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "orders"]
            },
            "description": "discount_amount = KD 5 (discount) + 15% of subtotal (coupon). total_price = subtotal minus combined discount."
          }
        },
        {
          "name": "Step 5 - Show Order (verify coupon_data cached)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "Step 6 - Update Coupon code (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HAPPY15V2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/coupons/{{coupon_id}}",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "coupons", "{{coupon_id}}"]
            }
          }
        },
        {
          "name": "Step 7 - Delete Coupon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/business/{{business_id}}/branches/{{branch_id}}/coupons/{{coupon_id}}/delete",
              "host": ["{{base_url}}"],
              "path": ["business", "{{business_id}}", "branches", "{{branch_id}}", "coupons", "{{coupon_id}}", "delete"]
            }
          }
        }
      ]
    }
  ]
